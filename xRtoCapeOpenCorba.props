<?xml version="1.0" encoding="utf-8"?>
<!--
  xRtoCapeOpenCorba.props
  ===================================================================
  CORBA/TAO 通路三个手写工程的公共属性表（与 CMake 的 WITH_*_CORBA 分支等价）：
    core\xRtoCapeOpen.vcxproj                -> xRtoCapeOpen.dll       (消费端模型 DLL)
    xOptMINLPco\xRtoCapeOpenSolver.vcxproj   -> xRtoCapeOpenSolver.dll (求解器桥接 DLL)
    xOptMINLPco\xOptMINLPcoSolverServer.vcxproj -> xOptMINLPcoSolverServer.exe (求解器服务端)

  这里集中：TAO 三元组路径、tao_idl 桩代码生成、以及三个工程都要重编的
  capeopen_core + COM/CORBA 后端 + IDL 桩源码。CMake 靠静态库共享，这里沿用
  既有手写 vcxproj（xOptMINLPco.vcxproj）的做法——直接把源码编进各自工程，
  不再造中间静态库。

  TAO 三元组（vcpkg ace[tao]，x64-windows-static-md）不写死路径，按下列顺序取
  第一个装了 tao_idl.exe 的 vcpkg：
    1. 命令行 msbuild ... /p:TaoTripletDir=E:\path\to\vcpkg\installed\x64-windows-static-md
    2. 环境变量 VCPKG_ROOT
    3. $(VcpkgRoot)（`vcpkg integrate install` 的用户级集成）
    4. 环境变量 VCPKG_INSTALLATION_ROOT（GitHub Actions 等 CI 镜像）
  逐个检查存在性是因为 VS 开发者命令行会把 VCPKG_ROOT 指向 VS 自带的 vcpkg，
  那份没有 installed\ 目录。都找不到时构建直接报错并给出提示。
  改 IDL(.idl) 或换 TAO 后，删掉 $(IntDir)idlgen 让 tao_idl 重新生成。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <!-- 本 props 就在仓库切片根 (…\libsrc\xRtoCapeOpen\)，据此锚定所有相对路径 -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- 仓库根 include（<xOpt/xOptProblem.h> 等 C 头）：…\cxxproj\include -->
    <XoptIncludeDir>$(RepoRoot)..\..\include</XoptIncludeDir>

    <!-- vcpkg 安装三元组目录（含 ACE/TAO 静态库与 tao_idl）。查找顺序见文件头注释 -->
    <TaoTriplet Condition="'$(TaoTriplet)'==''">x64-windows-static-md</TaoTriplet>
    <!-- 候选目录先单独算好：Condition 里 Exists('…') 不能再嵌套带引号的属性函数 -->
    <_TaoTripletFromVcpkgRootEnv Condition="'$(VCPKG_ROOT)'!=''">$([MSBuild]::EnsureTrailingSlash('$(VCPKG_ROOT)'))installed\$(TaoTriplet)</_TaoTripletFromVcpkgRootEnv>
    <_TaoTripletFromVcpkgIntegration Condition="'$(VcpkgRoot)'!=''">$([MSBuild]::EnsureTrailingSlash('$(VcpkgRoot)'))installed\$(TaoTriplet)</_TaoTripletFromVcpkgIntegration>
    <_TaoTripletFromCiVcpkg Condition="'$(VCPKG_INSTALLATION_ROOT)'!=''">$([MSBuild]::EnsureTrailingSlash('$(VCPKG_INSTALLATION_ROOT)'))installed\$(TaoTriplet)</_TaoTripletFromCiVcpkg>
    <TaoTripletDir Condition="'$(TaoTripletDir)'=='' and '$(_TaoTripletFromVcpkgRootEnv)'!='' and Exists('$(_TaoTripletFromVcpkgRootEnv)\tools\ace\tao_idl.exe')">$(_TaoTripletFromVcpkgRootEnv)</TaoTripletDir>
    <TaoTripletDir Condition="'$(TaoTripletDir)'=='' and '$(_TaoTripletFromVcpkgIntegration)'!='' and Exists('$(_TaoTripletFromVcpkgIntegration)\tools\ace\tao_idl.exe')">$(_TaoTripletFromVcpkgIntegration)</TaoTripletDir>
    <TaoTripletDir Condition="'$(TaoTripletDir)'=='' and '$(_TaoTripletFromCiVcpkg)'!='' and Exists('$(_TaoTripletFromCiVcpkg)\tools\ace\tao_idl.exe')">$(_TaoTripletFromCiVcpkg)</TaoTripletDir>
    <TaoIncludeDir>$(TaoTripletDir)\include</TaoIncludeDir>
    <TaoIdlExe>$(TaoTripletDir)\tools\ace\tao_idl.exe</TaoIdlExe>

    <!-- tao_idl 桩代码输出：逐工程逐配置放进各自 IntDir，互不污染 -->
    <IdlOutDir>$(IntDir)idlgen</IdlOutDir>
    <IdlGenDir>$(IdlOutDir)\</IdlGenDir>
  </PropertyGroup>

  <!-- 静态 ACE/TAO 的 lib 目录逐配置分开（debug 版库名带尾缀 d） -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <TaoLibDir>$(TaoTripletDir)\debug\lib</TaoLibDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'!='Debug'">
    <TaoLibDir>$(TaoTripletDir)\lib</TaoLibDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- TAO 生成的桩（CAPEOPEN100_UnitS.cpp 等）段数超 65535，必须 /bigobj -->
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
      <!-- TAO 头不吃 /permissive-，保持 MSVC 默认宽松模式（与 CMake 一致） -->
      <ConformanceMode>false</ConformanceMode>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- static-md 三元组 = 动态 CRT + 静态 ACE/TAO；ACE/TAO_AS_STATIC_LIBS 必给 -->
      <PreprocessorDefinitions>WIN32;_WINDOWS;ACE_AS_STATIC_LIBS=1;TAO_AS_STATIC_LIBS=1;CAPEOPEN_WITH_COM;CAPEOPEN_WITH_CORBA;_CRT_SECURE_NO_WARNINGS;_WINSOCK_DEPRECATED_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(RepoRoot)core;$(RepoRoot)core\backend\com;$(RepoRoot)core\backend\corba;$(XoptIncludeDir);$(IdlGenDir);$(TaoIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(TaoLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <!-- ACE/TAO 静态库：release 无尾缀，debug 带 d（与 vcpkg lib 目录一致） -->
  <ItemDefinitionGroup Condition="'$(Configuration)'!='Debug'">
    <Link>
      <AdditionalDependencies>TAO_CosNamings.lib;TAO_PortableServers.lib;TAO_AnyTypeCodes.lib;TAOs.lib;ACEs.lib;ws2_32.lib;mswsock.lib;advapi32.lib;user32.lib;iphlpapi.lib;ole32.lib;oleaut32.lib;uuid.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <Link>
      <AdditionalDependencies>TAO_CosNamingsd.lib;TAO_PortableServersd.lib;TAO_AnyTypeCodesd.lib;TAOsd.lib;ACEsd.lib;ws2_32.lib;mswsock.lib;advapi32.lib;user32.lib;iphlpapi.lib;ole32.lib;oleaut32.lib;uuid.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- TaoTripletDir 没解析到时尽早报错。不带 Inputs/Outputs，桩已是最新时也会检查，
       避免只剩一堆找不到 TAO 头的编译错误 -->
  <Target Name="ValidateTaoTripletDir">
    <Error Condition="'$(TaoTripletDir)'==''"
           Text="找不到装有 ace[tao] ($(TaoTriplet)) 的 vcpkg：请设置环境变量 VCPKG_ROOT、执行 vcpkg integrate install，或传 /p:TaoTripletDir=&lt;vcpkg&gt;\installed\$(TaoTriplet)" />
    <Error Condition="'$(TaoTripletDir)'!='' and !Exists('$(TaoIdlExe)')"
           Text="TaoTripletDir=$(TaoTripletDir) 下没有 tools\ace\tao_idl.exe，请确认已安装 vcpkg ace[tao]:$(TaoTriplet)" />
  </Target>

  <!-- ============ tao_idl：从 .idl 生成 C/S 桩（编译前） ============
       与 core/CMakeLists.txt 的三条 add_custom_command 一字对应：
         Minlp  只需 -I <TAO include>
         Unit / Ext  另加 -I <仓库切片根>（它们 #include 上一份复用 Common::*）
       -Yp,cl.exe 指定预处理器；VS/vcvars 构建时 cl 在 PATH 上。
       Inputs/Outputs 提供增量：桩比 .idl 新则跳过。 -->
  <Target Name="GenerateCapeOpenIdlStubs"
          BeforeTargets="ClCompile"
          DependsOnTargets="ValidateTaoTripletDir"
          Inputs="$(RepoRoot)CAPEOPEN100_Minlp.idl;$(RepoRoot)CAPEOPEN100_Unit.idl;$(RepoRoot)XOPTCO_Ext.idl"
          Outputs="$(IdlGenDir)CAPEOPEN100_MinlpC.cpp;$(IdlGenDir)CAPEOPEN100_UnitC.cpp;$(IdlGenDir)XOPTCO_ExtC.cpp">
    <MakeDir Directories="$(IdlOutDir)" />
    <Message Importance="high" Text="tao_idl: generating CAPE-OPEN CORBA stubs into $(IdlOutDir)" />
    <Exec Command="&quot;$(TaoIdlExe)&quot; -Yp,cl.exe -I &quot;$(TaoIncludeDir)&quot; -o &quot;$(IdlOutDir)&quot; &quot;$(RepoRoot)CAPEOPEN100_Minlp.idl&quot;" />
    <Exec Command="&quot;$(TaoIdlExe)&quot; -Yp,cl.exe -I &quot;$(TaoIncludeDir)&quot; -I &quot;$(RepoRoot.TrimEnd('\'))&quot; -o &quot;$(IdlOutDir)&quot; &quot;$(RepoRoot)CAPEOPEN100_Unit.idl&quot;" />
    <Exec Command="&quot;$(TaoIdlExe)&quot; -Yp,cl.exe -I &quot;$(TaoIncludeDir)&quot; -I &quot;$(RepoRoot.TrimEnd('\'))&quot; -o &quot;$(IdlOutDir)&quot; &quot;$(RepoRoot)XOPTCO_Ext.idl&quot;" />
  </Target>

  <!-- ============ 三个工程都要的公共源（IDL 桩 + core + COM/CORBA 后端） ============ -->
  <ItemGroup>
    <!-- tao_idl 生成的桩（GenerateCapeOpenIdlStubs 在 ClCompile 前产出） -->
    <ClCompile Include="$(IdlGenDir)CAPEOPEN100_MinlpC.cpp" />
    <ClCompile Include="$(IdlGenDir)CAPEOPEN100_MinlpS.cpp" />
    <ClCompile Include="$(IdlGenDir)CAPEOPEN100_UnitC.cpp" />
    <ClCompile Include="$(IdlGenDir)CAPEOPEN100_UnitS.cpp" />
    <ClCompile Include="$(IdlGenDir)XOPTCO_ExtC.cpp" />
    <ClCompile Include="$(IdlGenDir)XOPTCO_ExtS.cpp" />

    <!-- 后端无关核心（含 DLL 的 C 入口 xOptModel_createModel） -->
    <ClCompile Include="$(RepoRoot)core\CapeMINLPModelMock.cpp" />
    <ClCompile Include="$(RepoRoot)core\CapeMINLPProblemCore.cpp" />
    <ClCompile Include="$(RepoRoot)core\CapeBackendFactory.cpp" />
    <ClCompile Include="$(RepoRoot)core\xOptModelCapeOpen.cpp" />

    <!-- COM 后端（CAPEOPEN_WITH_COM；CapeBackendFactory 里按 "com:" 目标选它） -->
    <ClCompile Include="$(RepoRoot)core\backend\com\CapeVariantMarshal.cpp" />
    <ClCompile Include="$(RepoRoot)core\backend\com\CapeMINLPModelCom.cpp" />
    <ClCompile Include="$(RepoRoot)core\backend\com\CapeRegisterComBackend.cpp" />

    <!-- CORBA 后端（CAPEOPEN_WITH_CORBA；"corba:" 目标走它） -->
    <ClCompile Include="$(RepoRoot)core\backend\corba\CapeMINLPModelCorba.cpp" />
    <ClCompile Include="$(RepoRoot)core\backend\corba\CapeRegisterCorbaBackend.cpp" />
    <ClCompile Include="$(RepoRoot)core\backend\corba\CapeUnitCorba.cpp" />
  </ItemGroup>
</Project>
