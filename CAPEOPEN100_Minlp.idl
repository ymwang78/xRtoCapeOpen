                   ::CAPEOPEN100::Common::Error::ECapeUnknown);
        ::CAPEOPEN100::Common::Types::CapeInterface GetParameters()
            raises(::CAPEOPEN100::Common::Error::ECapeUnknown,
                   ::CAPEOPEN100::Common::Error::ECapeFailedInitialisation,
                   ::CAPEOPEN100::Common::Error::ECapeBadInvOrder);
      };

      interface ICapeMINLPSolverManager : ::CAPEOPEN100::Common::Identification::ICapeIdentification {
        void CreateMINLPSystem(in ::CAPEOPEN100::Common::Types::CapeInterface theMINLP, out ::CAPEOPEN100::Common::Types::CapeInterface theMINLPSystem)
            raises(::CAPEOPEN100::Common::Error::ECapeInvalidArgument,
                   ::CAPEOPEN100::Common::Error::ECapeOutOfResources,
                   ::CAPEOPEN100::Common::Error::ECapeNoMemory,
                   ::CAPEOPEN100::Common::Error::ECapeLicenceError,
                   ::CAPEOPEN100::Common::Error::ECapeUnknown,
